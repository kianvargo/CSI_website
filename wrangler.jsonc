// Cloudflare Workers configuration for the CSI Country Explorer (static site, no server code).
// Without this file, builds from main worked through automatic detection, but builds from other
// branches (pull-request previews) failed. Declaring the static assets explicitly makes both work.
{
  "name": "csi-website",
  "compatibility_date": "2026-10-01",
  "assets": {
    "directory": "."
  }
}
